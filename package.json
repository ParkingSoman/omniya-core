{
  "name": "omniya-core",
  "version": "0.1.0",
  "description": "Open-source workspace for blind mathematicians to create, organize, navigate, and return to mathematical proofs over time.",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test 'test/unit/*.test.js'",
    "test:e2e": "node --test --test-concurrency=1 'test/e2e/*.test.js'",
    "test:all": "npm test && npm run test:e2e"
  },
  "keywords": [
    "mathematics",
    "accessibility",
    "screen-reader",
    "latex",
    "mathml"
  ],
  "author": "Axiya",
  "license": "Apache-2.0",
  "dependencies": {
    "@mathjax/src": "^4.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "electron": "43.2.0",
    "playwright": "^1.62.1"
  }
}
