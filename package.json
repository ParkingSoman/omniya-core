    "accessibility",
    "screen-reader",
    "latex",
    "mathml"
  ],
  "author": "Axiya",
  "license": "Apache-2.0",
  "dependencies": {
    "mathjax-full": "^3.2.2",
    "fast-xml-parser": "^4.4.0"
  },
  "devDependencies": {}
}
