{
  "name": "omniya-core",
  "version": "0.1.0",
  "description": "Experimental local-first prototype exploring screen-reader-first mathematical workspaces.",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "open:napkin": "node scripts/open-napkin.mjs",
    "test": "node --test 'test/unit/*.test.js'",
    "test:e2e": "node --test --test-concurrency=1 'test/e2e/*.test.js'",
    "test:accuracy": "node --test test/unit/nemeth-braille-accuracy.test.js",
    "test:nemeth-electron-links": "node scripts/verify-nemeth-electron-coverage.mjs",
    "test:all": "npm test && npm run test:e2e",
    "nemeth:report": "node scripts/guided-nemeth-report.mjs docs/guided-nemeth-conformance.json",
    "test:inspect": "node test/inspect.mjs"
  },
  "keywords": [
    "mathematics",
    "accessibility",
    "screen-reader",
    "latex",
    "mathml"
  ],
  "author": "Axiya",
  "license": "Apache-2.0",
  "dependencies": {
    "@mathjax/src": "4.1.3"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "electron": "43.2.0",
    "playwright": "^1.62.1",
    "speech-rule-engine": "5.0.0-rc.4"
  }
}
