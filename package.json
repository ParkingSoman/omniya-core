{
  "name": "omniya-core",
  "version": "0.1.0",
  "description": "Experimental local-first prototype exploring screen-reader-first mathematical workspaces.",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dist:mac": "node scripts/stage-liblouis.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "dist:win": "node scripts/stage-liblouis.mjs && electron-builder --win --x64 --publish always",
    "version:bump": "node scripts/bump-testing-version.mjs",
    "open:napkin": "node scripts/open-napkin.mjs",
    "test": "node --test 'test/unit/**/*.test.js'",
    "test:e2e": "node --test --test-concurrency=1 'test/e2e/*.test.js'",
    "test:demo:thought": "OMNIYA_HEADLESS=0 OMNIYA_THOUGHT_DEMO=1 node --test --test-concurrency=1 test/demo/thought-stream-demo.test.js",
    "test:all": "npm test && npm run test:e2e",
    "test:inspect": "node test/inspect.mjs",
    "nemeth:coverage": "node scripts/nemeth-coverage.mjs",
    "nemeth:utility": "node scripts/nemeth-utility.mjs"
  },
  "keywords": [
    "mathematics",
    "accessibility",
    "screen-reader",
    "latex",
    "mathml"
  ],
  "author": "Axiya",
  "license": "Apache-2.0",
  "dependencies": {
    "@mathjax/src": "4.1.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "speech-rule-engine": "5.0.0-rc.4"
  }
}
