{
  "name": "omniya-core",
  "version": "0.1.0",
  "description": "Open-source workspace for blind mathematicians to create, organize, navigate, and return to mathematical proofs over time.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --experimental-vm-modules node_modules/vsce/bin/vsce.js package.json",
